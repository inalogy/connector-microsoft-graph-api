        <targetRef oid="00000000-0000-0000-0000-000000000503" relation="org:default" type="c:ArchetypeType"/>
    </assignment>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" relation="org:default" type="c:UserType"/>
    <executionState>suspended</executionState>
    <schedulingState>suspended</schedulingState>
    <objectRef oid="a5e35e85-3e32-40a8-92f8-68796f48955b" relation="org:default" type="c:ResourceType"/>
    <binding>loose</binding>
    <activity>
        <work>
            <import>
                <resourceObjects>
                    <resourceRef oid="a5e35e85-3e32-40a8-92f8-68796f48955b" relation="org:default" type="c:ResourceType"/>
                    <kind>entitlement</kind>
                    <intent>directoryrole</intent>
                    <objectclass>ri:CustomRoleObjectClass</objectclass>
                </resourceObjects>
            </import>
        </work>
    </activity>
</task>
