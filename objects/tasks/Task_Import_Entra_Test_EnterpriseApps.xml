    <schedulingState>suspended</schedulingState>
    <objectRef oid="a5e35e85-3e32-40a8-92f8-68796f48955b" relation="org:default" type="c:ResourceType"/>
    <binding>loose</binding>
    <activity>
        <work>
            <import>
                <resourceObjects>
                    <resourceRef oid="a5e35e85-3e32-40a8-92f8-68796f48955b" relation="org:default" type="c:ResourceType"/>
                    <kind>entitlement</kind>
                    <intent>enterpriseapp</intent>
                    <objectclass>ri:CustomservicePrincipalObjectClass</objectclass>
                </resourceObjects>
            </import>
        </work>
    </activity>
</task>
